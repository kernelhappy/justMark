{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustMark",
  "version": "0.1.0",
  "identifier": "io.github.justmark",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "fileAssociations": [{ "ext": ["png", "jpg", "jpeg"], "name": "JustMark.Image", "role": "Editor" }]
  }
}
